{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{supabase/schema.sql,dist/_spa.html}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-agent-report",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/services",
      "destination": "/api/index"
    },
    {
      "source": "/insights",
      "destination": "/api/index"
    },
    {
      "source": "/insights/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/about",
      "destination": "/api/index"
    },
    {
      "source": "/contact",
      "destination": "/api/index"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/index"
    },
    {
      "source": "/terms",
      "destination": "/api/index"
    },
    {
      "source": "/cookie-policy",
      "destination": "/api/index"
    },
    {
      "source": "/disclaimer",
      "destination": "/api/index"
    },
    {
      "source": "/editorial-policy",
      "destination": "/api/index"
    },
    {
      "source": "/demo",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|src/assets/|favicon).*)",
      "destination": "/_spa.html"
    }
  ],
  "headers": [
    {
      "source": "/obama",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/obama/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
