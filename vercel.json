{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/schema.sql"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-agent-report",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|src/assets/|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/obama",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/obama/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
